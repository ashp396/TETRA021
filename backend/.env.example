DATABASE_URL=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440

# LLM provider, free tier available at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: only needed if you want ElevenLabs voices instead of the
# built in free edge tts voice. Leave blank to use the free voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000
